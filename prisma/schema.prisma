generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ApplicationStatus {
  NEW
  CONTACTED
  APPROVED
  DECLINED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  OFFLINE
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum DonationProvider {
  PAYSTACK
  STRIPE
  OFFLINE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  role         Role          @default(EDITOR)
  createdAt    DateTime      @default(now())
  stories      Story[]
  activityLogs ActivityLog[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Program {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  summary             String
  description         String        @db.Text
  icon                String
  coverImage          String?
  order               Int           @default(0)
  published           Boolean       @default(true)
  donationOutcomeText String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  testimonials        Testimonial[]
  donations           Donation[]
  events              Event[]

  @@index([order])
  @@index([published])
}

model Story {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  contentRich  String    @db.Text
  coverImage   String?
  category     String
  subjectName  String?
  subjectPhoto String?
  pullQuote    String?   @db.Text
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id])
  published    Boolean   @default(false)
  publishedAt  DateTime?
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String   @db.Text
  photo       String?
  order       Int      @default(0)
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Testimonial {
  id             String   @id @default(cuid())
  quote          String   @db.Text
  name           String
  photo          String?
  ageOrDetail    String?
  programId      String?
  program        Program? @relation(fields: [programId], references: [id])
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Event {
  id                String              @id @default(cuid())
  slug              String              @unique
  title             String
  description       String              @db.Text
  startAt           DateTime
  endAt             DateTime?
  location          String
  coverImage        String?
  capacity          Int?
  fundingGoal       Int?
  programId         String?
  program           Program?            @relation(fields: [programId], references: [id])
  registrationOpen  Boolean             @default(true)
  published         Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  registrations     EventRegistration[]

  @@index([startAt])
  @@index([published])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([email])
  @@index([createdAt])
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String
  altText    String
  album      String?
  uploadedAt DateTime @default(now())

  @@index([album])
  @@index([uploadedAt])
}

model VolunteerApplication {
  id        String            @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String            @db.Text
  status    ApplicationStatus @default(NEW)
  createdAt DateTime          @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model PartnerInquiry {
  id          String            @id @default(cuid())
  orgName     String
  contactName String
  email       String
  message     String            @db.Text
  status      ApplicationStatus @default(NEW)
  createdAt   DateTime          @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)

  @@index([active])
  @@index([subscribedAt])
}

model Donation {
  id              String            @id @default(cuid())
  donorName       String
  donorEmail      String
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("GHS")
  frequency       DonationFrequency @default(ONE_TIME)
  provider        DonationProvider
  providerRef     String?
  status          DonationStatus    @default(PENDING)
  programId       String?
  program         Program?          @relation(fields: [programId], references: [id])
  attributionNote String?           @db.Text
  createdAt       DateTime          @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([donorEmail])
  @@index([providerRef])
  @@index([programId])
}

model SiteSetting {
  key   String @id
  value String @db.Text
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
}
